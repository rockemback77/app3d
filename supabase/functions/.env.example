# Secrets do webhook Mercado Pago — TEMPLATE.
#
# Como usar (depois, quando tiver os valores reais):
#   1. copie este arquivo para .env (mesma pasta)
#   2. preencha os valores
#   3. rode: supabase secrets set --env-file ./supabase/functions/.env
#
# O .env com valores reais NAO deve ser comitado (ja esta no .gitignore).

# Access Token de PRODUCAO da sua aplicacao Mercado Pago.
# MP > Suas integracoes > (sua app) > Credenciais de producao > Access Token.
MP_ACCESS_TOKEN=

# Chave secreta do webhook — e ela que assina o header x-signature.
# MP > (sua app) > Webhooks > Chave secreta.
MP_WEBHOOK_SECRET=

# NAO definir aqui: SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY sao injetados
# automaticamente pelo Supabase no runtime da Edge Function.
